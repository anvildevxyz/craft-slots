# Keep the distributed package lean: exclude dev-only paths from the
# Packagist/`composer install --prefer-dist` archive. Source installs are
# unaffected, so contributors still get everything.
/tests              export-ignore
/scripts            export-ignore
/stubs              export-ignore
/storage            export-ignore
/.github            export-ignore
/phpunit.xml        export-ignore
/phpstan.neon       export-ignore
/ecs.php            export-ignore
/rector.php         export-ignore
/vitest.config.js   export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore

# Internal: documents the fork relationship to upstream Booked for maintainers.
# Kept in the repo, not shipped to the people who install the plugin.
/SYNC.md            export-ignore
