{#
/**
 * Booking Management Template
 *
 * Displays booking details and allows user to cancel or reschedule
 * Accessed via: /booking/manage/{token}
 *
 * Variables:
 * - reservation: ReservationInterface
 * - canCancel: bool
 * - isPast: bool
 */
#}

{# Use the project's layout when it has one; fall back to the plugin's so the
   page renders on a site that ships no `_layout`. #}
{% extends craft.app.view.doesTemplateExist('_layout') ? '_layout' : 'slots/_fallback-layout' %}
{% do view.registerAssetBundle("anvildev\\slots\\assetbundles\\SlotsAsset") %}
{% do view.registerAssetBundle("anvildev\\slots\\assetbundles\\SlotsManagePageAsset") %}

{% set bodyClass = 'page-booking-management' %}

{% set service = reservation.getService() %}
{% set employee = reservation.getEmployee() %}
{% set location = reservation.getLocation() %}
{% set isCancelled = reservation.status == 'cancelled' %}
{% set canEditQuantity = reservation.getQuantity() > 1 %}
{% set bookingPageUrl = craft.slots.getSettings().bookingPageUrl ?? '/' %}

{% block content %}
<div class="slots-wizard">

    {% if craft.app.session.hasFlash('notice') %}
        <div class="slots-flash">
            <p>{{ craft.app.session.getFlash('notice') }}</p>
        </div>
    {% endif %}

    {% if craft.app.session.hasFlash('error') %}
        <div class="slots-flash flash-error">
            <p>{{ craft.app.session.getFlash('error') }}</p>
        </div>
    {% endif %}

    {# Black header band — mirrors the wizard step indicator #}
    <div class="slots-manage-bar">
        <span class="slots-manage-bar-label">
            {% if isCancelled %}
                {{ 'templates.bookingAlreadyCancelled'|t('slots') }}
            {% elseif isPast %}
                {{ 'templates.bookingCompleted'|t('slots') }}
            {% else %}
                {{ 'templates.yourBooking'|t('slots') }}
            {% endif %}
        </span>
        <span class="slots-manage-bar-id">#{{ reservation.getId() }}</span>
    </div>

    {# Hero — date/time as the focal point #}
    <div class="slots-manage-hero">
        <div class="slots-manage-datetime{% if isCancelled %} slots-struck{% endif %}">
            {{ reservation.getFormattedDateTime() }}
        </div>
        {% if service %}
            <div class="slots-manage-service">{{ service.title }}</div>
        {% endif %}
        {% if isCancelled %}
            <span class="slots-status-badge slots-status-badge--cancelled">
                {{ 'status.cancelled'|t('slots') }}
            </span>
        {% elseif isPast %}
            <span class="slots-status-badge slots-status-badge--past">
                {{ 'status.completed'|t('slots') }}
            </span>
        {% endif %}
    </div>

    {# Content sections #}
    <div class="slots-manage-body">

        {# Booking details #}
        <div class="slots-manage-section slots-manage-reveal" style="animation-delay: 0.05s">
            <div class="slots-manage-section-title">{{ 'templates.bookingDetails'|t('slots') }}</div>
            <div class="slots-manage-grid">
                <div class="slots-manage-row">
                    <span class="slots-manage-label">{{ 'templates.dateTime'|t('slots') }}</span>
                    <span class="slots-manage-value{% if isCancelled %} slots-struck{% endif %}">{{ reservation.getFormattedDateTime() }}</span>
                </div>
                <div class="slots-manage-row">
                    <span class="slots-manage-label">{{ 'templates.duration'|t('slots') }}</span>
                    <span class="slots-manage-value">{{ reservation.getDurationMinutes() }} {{ 'templates.minutes'|t('slots') }}</span>
                </div>
                {% if employee %}
                    <div class="slots-manage-row">
                        <span class="slots-manage-label">{{ 'labels.employee'|t('slots') }}</span>
                        <span class="slots-manage-value">{{ employee.title }}</span>
                    </div>
                {% endif %}
                {% if location %}
                    <div class="slots-manage-row">
                        <span class="slots-manage-label">{{ 'labels.location'|t('slots') }}</span>
                        <span class="slots-manage-value">{{ location.title }}</span>
                    </div>
                {% endif %}
                {% if canEditQuantity or reservation.getQuantity() > 1 %}
                    <div class="slots-manage-row">
                        <span class="slots-manage-label">{{ 'wizard.manageQuantity'|t('slots') }}</span>
                        <span class="slots-manage-value">{{ reservation.getQuantity() }}</span>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Customer info #}
        <div class="slots-manage-section slots-manage-reveal" style="animation-delay: 0.1s">
            <div class="slots-manage-section-title">{{ 'templates.customerInfo'|t('slots') }}</div>
            <div class="slots-manage-grid">
                <div class="slots-manage-row">
                    <span class="slots-manage-label">{{ 'templates.name'|t('slots') }}</span>
                    <span class="slots-manage-value">{{ reservation.userName }}</span>
                </div>
                <div class="slots-manage-row">
                    <span class="slots-manage-label">{{ 'templates.email'|t('slots') }}</span>
                    <span class="slots-manage-value">{{ reservation.userEmail }}</span>
                </div>
                {% if reservation.userPhone %}
                    <div class="slots-manage-row">
                        <span class="slots-manage-label">{{ 'templates.phone'|t('slots') }}</span>
                        <span class="slots-manage-value">{{ reservation.userPhone }}</span>
                    </div>
                {% endif %}
                {% if reservation.notes %}
                    <div class="slots-manage-row">
                        <span class="slots-manage-label">{{ 'templates.notes'|t('slots') }}</span>
                        <span class="slots-manage-value">{{ reservation.notes }}</span>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Quantity adjustment #}
        {% if not isPast and not isCancelled and canEditQuantity %}
            <div class="slots-manage-section slots-manage-reveal" style="animation-delay: 0.15s">
                <div class="slots-manage-section-title">{{ 'wizard.manageChangeAmount'|t('slots') }}</div>
                <div class="slots-quantity-row">
                    <input
                        type="number"
                        id="slots-new-quantity"
                        value="{{ reservation.getQuantity() }}"
                        min="1"
                        class="slots-quantity-input"
                    >
                    <button type="button" class="btn" id="slots-quantity-submit" disabled>
                        {{ 'templates.updateQuantity'|t('slots') }}
                    </button>
                </div>
                <p class="slots-quantity-error" id="slots-quantity-error"></p>
            </div>
        {% endif %}

        {# Reschedule #}
        {% if not isPast and not isCancelled and canReschedule %}
            <div class="slots-manage-section slots-manage-reveal" style="animation-delay: 0.18s">
                <div class="slots-manage-section-title">{{ 'templates.rescheduleBooking'|t('slots') }}</div>

                <input
                    type="date"
                    id="slots-reschedule-date"
                    class="slots-quantity-input slots-reschedule-date"
                    min="{{ now|date('Y-m-d') }}"
                    value="{{ reservation.getBookingDate() }}"
                    aria-label="{{ 'templates.rescheduleChooseDate'|t('slots') }}"
                >

                <div class="slots-reschedule-slots" id="slots-reschedule-slots" role="group"
                     aria-label="{{ 'templates.rescheduleChooseTime'|t('slots') }}"></div>

                <button type="button" class="btn btn-primary slots-reschedule-submit" id="slots-reschedule-submit" disabled>
                    {{ 'templates.rescheduleConfirm'|t('slots') }}
                </button>

                <p class="slots-quantity-error" id="slots-reschedule-error"></p>

            </div>
        {% endif %}

        {# Everything the quantity and reschedule controls need, handed over as
           data rather than as generated code. A script element with a non-JS
           type is never executed, so a strict CSP leaves it alone — which is the whole
           point: this page is reached from an email link and used to be the one
           front-end surface that needed 'unsafe-inline' to work.

           Encoded with JSON_HEX_* so the reflected manage token can't break out
           of the block, independent of json_encode's slash-escaping — same
           posture as the wizard's config block. #}
        {% if not isPast and not isCancelled and (canEditQuantity or canReschedule) %}
            {% set manageConfig = {
                reservationId: reservation.getId(),
                token: reservation.getConfirmationToken(),
                quantity: reservation.getQuantity(),
                employeeId: reservation.getEmployeeId(),
                locationId: reservation.getLocationId(),
                serviceId: reservation.getServiceId(),
                currentDate: reservation.getBookingDate(),
                currentStart: reservation.getStartTime(),
                redirectUrl: reservation.getManagementUrl(),
                csrf: {
                    name: craft.app.config.general.csrfTokenName,
                    value: craft.app.request.csrfToken,
                },
                actions: {
                    reduceQuantity: actionUrl('slots/booking-management/reduce-quantity'),
                    increaseQuantity: actionUrl('slots/booking-management/increase-quantity'),
                    availableSlots: actionUrl('slots/slot/get-available-slots'),
                    manageBooking: actionUrl('slots/booking-management/manage-booking'),
                },
                labels: {
                    quantityFailed: 'templates.quantityUpdateFailed'|t('slots'),
                    loading: 'templates.rescheduleLoading'|t('slots'),
                    none: 'templates.rescheduleNoSlots'|t('slots'),
                    failed: 'templates.rescheduleFailed'|t('slots'),
                    current: 'templates.rescheduleCurrentSlot'|t('slots'),
                },
            } %}
            <script type="application/json" data-slots-manage-config>{{ manageConfig|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_AMP') b-or constant('JSON_HEX_QUOT'))|raw }}</script>
        {% endif %}

        {# Actions #}
        <div class="slots-manage-actions slots-manage-reveal" style="animation-delay: 0.2s">
            {% if not isPast and not isCancelled %}
                <a href="{{ reservation.getIcsUrl() }}" class="btn">
                    {{ 'account.addToCalendar'|t('slots') }}
                </a>
                {% if canCancel %}
                    <a href="{{ reservation.getCancelUrl() }}" class="slots-btn-danger-outline">
                        {{ 'templates.cancelBooking'|t('slots') }}
                    </a>
                {% endif %}
            {% elseif not isCancelled %}
                <p class="slots-manage-notice">{{ 'templates.cannotCancelBooking'|t('slots') }}</p>
            {% endif %}
            <a href="{{ bookingPageUrl }}" class="btn btn-primary">
                {{ 'templates.bookNewAppointment'|t('slots') }}
            </a>
        </div>
    </div>

</div>
{% endblock %}
